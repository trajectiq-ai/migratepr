{
  "name": "migratepr",
  "version": "1.0.0",
  "description": "Self-maintaining APIs: automated, test-verified migration PRs for third-party API breaking changes (Stripe first)",
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "bin": {
    "migratepr": "dist/src/cli.js",
    "migratepr-web": "dist/src/web/server.js"
  },
  "main": "dist/src/cli.js",
  "files": [
    "dist/src",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "repository": {
    "type": "git",      "url": "git+https://github.com/trajectiq-ai/migratepr.git"
  },
  "keywords": [
    "codemod",
    "migration",
    "stripe",
    "api",
    "ast",
    "ts-morph",
    "dependabot",
    "automation"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "demo": "npm run build && node dist/src/demo.js",
    "cli": "node dist/src/cli.js",
    "web": "npm run build && node dist/src/web/server.js",
    "web:start": "node dist/src/web/server.js"
  },
  "dependencies": {
    "ts-morph": "^23.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  }
}
